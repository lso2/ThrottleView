<UserControl x:Class="ThrottleView.UI.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ThrottleView.UI"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource BgBrush}" CornerRadius="0,0,12,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
            <StackPanel>

                <Grid>
                    <TextBlock Style="{StaticResource H2}" Text="Throttle history" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="Range1h" Style="{StaticResource RangePill}" Content="1 hour" GroupName="range" Checked="Range_Changed" />
                        <RadioButton x:Name="Range24h" Style="{StaticResource RangePill}" Content="24 hours" GroupName="range" IsChecked="True" Checked="Range_Changed" />
                        <RadioButton x:Name="Range7d" Style="{StaticResource RangePill}" Content="7 days" GroupName="range" Checked="Range_Changed" />
                    </StackPanel>
                </Grid>

                <!-- Summary -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="170">
                            <TextBlock x:Name="SummaryPct" Text="--" FontSize="46" FontWeight="SemiBold" />
                            <TextBlock x:Name="SummaryCaption" Style="{StaticResource Caption}" Text="of the last 24 hours throttled" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="26,2,26,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}" Text="CAUSE BREAKDOWN" Margin="0,0,0,8" />
                            <Border CornerRadius="7" Height="16" ClipToBounds="True" Background="{DynamicResource PanelAltBrush}">
                                <Grid x:Name="BreakdownGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SegCpu" Grid.Column="0" Background="{DynamicResource AccentBrush}" />
                                    <Border x:Name="SegRam" Grid.Column="1" Background="{DynamicResource RamBrush}" />
                                    <Border x:Name="SegDisk" Grid.Column="2" Background="{DynamicResource DiskBrush}" />
                                    <Border x:Name="SegFree" Grid.Column="3" Background="Transparent" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LegCpu" Style="{StaticResource Caption}" Margin="6,0,0,0" Text="CPU" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource RamBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LegRam" Style="{StaticResource Caption}" Margin="6,0,0,0" Text="RAM" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource DiskBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LegDisk" Style="{StaticResource Caption}" Margin="6,0,0,0" Text="Disk" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="150">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <StackPanel MinWidth="150">
                                    <TextBlock Style="{StaticResource Caption}" Text="EPISODES" />
                                    <TextBlock x:Name="StatEpisodes" Style="{StaticResource Value}" Text="--" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <StackPanel MinWidth="150">
                                    <TextBlock Style="{StaticResource Caption}" Text="WORST DELIVERED" />
                                    <TextBlock x:Name="StatWorst" Style="{StaticResource Value}" Text="--" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="PEAK TEMP" />
                                <TextBlock x:Name="StatPeakTemp" Style="{StaticResource Value}" Text="--" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Throttle over time -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Time throttled" />
                        <ui:StackBars x:Name="Bars" Height="156" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Temperature history -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Temperature" />
                        <Grid Margin="0,10,0,0">
                            <ui:LiveGraph x:Name="TempGraph" Height="120" />
                            <TextBlock x:Name="TempEmpty" Style="{StaticResource Caption}" Text="No temperature sensor data in this range." HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Episodes -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Recent throttle episodes" />
                        <StackPanel x:Name="EpisodesPanel" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Apps -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Apps most involved in throttling" />
                        <StackPanel x:Name="HistoryAppsPanel" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
