<Window x:Class="ThrottleView.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ThrottleView.UI"
        Title="ThrottleView" Height="740" Width="1120" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BgBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/ThrottleView;component/throttleview.ico" Width="18" Height="18" Margin="0,0,9,0" />
                        <TextBlock Text="ThrottleView" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <Border Margin="12,0,0,0" Padding="7,2" CornerRadius="6" Background="{DynamicResource PanelAltBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="live" FontSize="10.5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton x:Name="LiveTab" Style="{StaticResource NavTab}" Content="Live" GroupName="nav" IsChecked="True" Checked="Tab_Changed" />
                        <RadioButton x:Name="HistoryTab" Style="{StaticResource NavTab}" Content="History" GroupName="nav" Checked="Tab_Changed" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsBtn" Style="{StaticResource TitleBarButton}" Click="Settings_Click" ToolTip="Settings">
                            <TextBlock Style="{StaticResource IconGlyph}" FontSize="14" Text="&#xE713;" />
                        </Button>
                        <Button x:Name="MinBtn" Style="{StaticResource TitleBarButton}" Click="Min_Click">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE921;" />
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}" Click="Close_Click">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="LivePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                    <StackPanel>

                        <!-- Status banner -->
                        <Border Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: load gauge with the readings that explain the load -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Caption}" Text="SYSTEM LOAD" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                    <ui:GaugeControl x:Name="LoadGauge" Width="172" Height="132" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="22,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Style="{StaticResource Caption}" Text="EFFECTIVE CLOCK" />
                                    <TextBlock x:Name="BannerClock" Style="{StaticResource Value}" Text="--" />
                                    <TextBlock x:Name="BannerClockBase" Style="{StaticResource Caption}" Text="base --" />
                                    <TextBlock Style="{StaticResource Caption}" Text="TOP PROCESS" Margin="0,14,0,0" />
                                    <TextBlock x:Name="BannerTopApp" Style="{StaticResource Value}" Text="--" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="BannerTopAppSub" Style="{StaticResource Caption}" Text="" />
                                </StackPanel>

                                <!-- Right: the throttle verdict and the readings that drive it, beside the throttle gauge -->
                                <StackPanel Grid.Column="2" Margin="16,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock x:Name="StateText" Style="{StaticResource H1}" Text="Starting up" TextAlignment="Right" />
                                    <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" Text="Reading performance counters" TextWrapping="Wrap" TextAlignment="Right" />
                                    <TextBlock Style="{StaticResource Caption}" Text="TEMPERATURE" Margin="0,14,0,0" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="BannerTemp" Style="{StaticResource Value}" Text="--" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="BannerTempSrc" Style="{StaticResource Caption}" Text="" HorizontalAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Caption}" Text="THROTTLE" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                    <ui:GaugeControl x:Name="ThrottleGauge" Width="172" Height="132" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Metric cards -->
                        <UniformGrid Columns="5" Margin="0,12,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="CPU CLOCK" />
                                    <TextBlock x:Name="CardClock" Style="{StaticResource Value}" Margin="0,3,0,0" Text="--" />
                                    <TextBlock x:Name="CardClockSub" Style="{StaticResource Caption}" Text="--" />
                                    <Border Height="6" CornerRadius="3" Margin="0,10,0,0" Background="{DynamicResource PanelAltBrush}">
                                        <Border CornerRadius="3" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="CardClockBar" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="3,0,3,0" Padding="14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="THROTTLE" />
                                    <TextBlock x:Name="CardDelivered" Style="{StaticResource Value}" Margin="0,3,0,0" Text="--" />
                                    <TextBlock x:Name="CardDeliveredSub" Style="{StaticResource Caption}" Text="none" />
                                    <Border Height="6" CornerRadius="3" Margin="0,10,0,0" Background="{DynamicResource PanelAltBrush}">
                                        <Border x:Name="CardDeliveredFill" CornerRadius="3" Background="{DynamicResource DeliveredBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="CardDeliveredBar" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="3,0,3,0" Padding="14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="MEMORY" />
                                    <TextBlock x:Name="CardMem" Style="{StaticResource Value}" Margin="0,3,0,0" Text="--" />
                                    <TextBlock x:Name="CardMemSub" Style="{StaticResource Caption}" Text="--" />
                                    <Border Height="6" CornerRadius="3" Margin="0,10,0,0" Background="{DynamicResource PanelAltBrush}">
                                        <Border CornerRadius="3" Background="{DynamicResource RamBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="CardMemBar" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="3,0,3,0" Padding="14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="DISK LATENCY" />
                                    <TextBlock x:Name="CardDisk" Style="{StaticResource Value}" Margin="0,3,0,0" Text="--" />
                                    <TextBlock x:Name="CardDiskSub" Style="{StaticResource Caption}" Text="--" />
                                    <Border Height="6" CornerRadius="3" Margin="0,10,0,0" Background="{DynamicResource PanelAltBrush}">
                                        <Border CornerRadius="3" Background="{DynamicResource DiskBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="CardDiskBar" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="TEMPERATURE" />
                                    <TextBlock x:Name="CardTemp" Style="{StaticResource Value}" Margin="0,3,0,0" Text="--" />
                                    <TextBlock x:Name="CardTempSub" Style="{StaticResource Caption}" Text="--" />
                                    <Border Height="6" CornerRadius="3" Margin="0,10,0,0" Background="{DynamicResource PanelAltBrush}">
                                        <Border CornerRadius="3" Background="{DynamicResource TempBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform><ScaleTransform x:Name="CardTempBar" ScaleX="0" /></Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Live graph -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource H2}" Text="Last 90 seconds" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource DeliveredBrush}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="5,0,0,0" Text="Throttle" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="5,0,0,0" Text="CPU load" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource RamBrush}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="5,0,0,0" Text="RAM" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource TempBrush}" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="5,0,0,0" Text="Temp" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <ui:LiveGraph x:Name="Graph" Height="208" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Margin="34,8,0,3" Text="Throttle timeline" />
                                <ui:TimelineRibbon x:Name="Timeline" Height="18" Margin="34,0,8,0" />
                            </StackPanel>
                        </Border>

                        <!-- Top processes -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Top processes" />
                                <StackPanel x:Name="TopAppsPanel" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <ui:HistoryView x:Name="History" Visibility="Collapsed" />
            </Grid>

            <!-- Footer: name and version, GitHub, Donate -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" CornerRadius="0,0,12,12">
                <Grid>
                    <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource StrokeSoftBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,7">
                        <TextBlock x:Name="FooterName" Text="ThrottleView" FontSize="12" Opacity="0.7" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="&#x2022;" FontSize="12" Opacity="0.4" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource FooterLink}" Click="GitHub_Click" ToolTip="github.com/lso2/ThrottleView">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GitHubIcon}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="GitHub" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="&#x2022;" FontSize="12" Opacity="0.4" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource FooterLink}" Click="Donate_Click" ToolTip="plexpixel.com/donate">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource DonateIcon}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="Donate" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
