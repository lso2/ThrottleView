<Window x:Class="ThrottleView.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThrottleView Settings" Width="468" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- Threshold fields: the shared TextBox style, narrow and right-aligned -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="92" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="16,10">
                    <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Close_Click">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8BB;" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="GENERAL" Margin="0,0,0,10" />
                    <CheckBox x:Name="ChkStartup" Content="Start with Windows" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Throttling is measured from the CPU's reported clock against its base clock." />

                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,16" />

                    <TextBlock Style="{StaticResource Caption}" Text="THROTTLE THRESHOLDS" Margin="0,0,0,12" />
                    <Grid x:Name="FieldsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,7" TextWrapping="Wrap" Text="CPU clock is throttled below (% of base)" />
                        <TextBox x:Name="FClockBelow" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,7" TextWrapping="Wrap" Text="...only when CPU load is at least (%)" />
                        <TextBox x:Name="FCpuBusy" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,7" TextWrapping="Wrap" Text="CPU counts as saturated at (%)" />
                        <TextBox x:Name="FCpuSat" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,7" TextWrapping="Wrap" Text="Memory commit is high at (%)" />
                        <TextBox x:Name="FCommit" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,7" TextWrapping="Wrap" Text="Low memory under (MB free)" />
                        <TextBox x:Name="FAvail" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,7" TextWrapping="Wrap" Text="Hard faults/sec that confirm paging" />
                        <TextBox x:Name="FPaging" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,7" TextWrapping="Wrap" Text="Disk latency is high at (ms)" />
                        <TextBox x:Name="FDiskLat" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,7" TextWrapping="Wrap" Text="CPU is hot (thermal) at (&#176;C)" />
                        <TextBox x:Name="FTempHot" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" CornerRadius="0,0,12,12" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SubtleButton}" Content="Cancel" Click="Close_Click" Margin="0,0,10,0" />
                    <Button Style="{StaticResource AccentButton}" Content="Save" Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
