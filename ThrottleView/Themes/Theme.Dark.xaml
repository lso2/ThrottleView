<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Styles live in Controls.xaml and reference these by DynamicResource, so the
         load order between the two dictionaries does not matter. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ThrottleView;component/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="BgBrush"            Color="#FF14161A" />
    <SolidColorBrush x:Key="TitleBarBrush"      Color="#FF15171C" />
    <SolidColorBrush x:Key="PanelBrush"         Color="#FF1C1F26" />
    <SolidColorBrush x:Key="PanelAltBrush"      Color="#FF23272F" />
    <SolidColorBrush x:Key="StrokeBrush"        Color="#FF2C313B" />
    <SolidColorBrush x:Key="StrokeSoftBrush"    Color="#FF23262E" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFE8EAED" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA3B2" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#FF6B7280" />

    <SolidColorBrush x:Key="AccentBrush"        Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="OkBrush"            Color="#FF3FB96D" />
    <SolidColorBrush x:Key="WarnBrush"          Color="#FFE8B03F" />
    <SolidColorBrush x:Key="DangerBrush"        Color="#FFE05A5A" />
    <SolidColorBrush x:Key="RamBrush"           Color="#FFB06CF0" />
    <SolidColorBrush x:Key="DiskBrush"          Color="#FFE0A93C" />
    <SolidColorBrush x:Key="DeliveredBrush"     Color="#FF36C6B0" />
    <SolidColorBrush x:Key="TempBrush"          Color="#FFF06C8A" />

    <SolidColorBrush x:Key="HoverOverlay"       Color="#18FFFFFF" />
    <SolidColorBrush x:Key="PressOverlay"       Color="#28FFFFFF" />

</ResourceDictionary>
